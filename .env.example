# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENAI_API_KEY: Optional/Alternative LLM Engine for Store Advisor & Agent Synthesis.
OPENAI_API_KEY=""

# GOOGLE_CLOUD_PROJECT: The GCP project ID for Sheets/Drive API calls.
GOOGLE_CLOUD_PROJECT=""

# GOOGLE_SHEETS_SPREADSHEET_ID: The Spreadsheet ID for catalog synchronization.
GOOGLE_SHEETS_SPREADSHEET_ID="1hHgZxURsUk_n6oAPh7IJYEqFre_AM0rGKtMXVnzdTxE"

# GOOGLE_SHEETS_SERVICE_ACCOUNT_EMAIL: The email of the authorized Service Account.
GOOGLE_SHEETS_SERVICE_ACCOUNT_EMAIL=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PostHog Telemetry (Required for production analytics)
POSTHOG_API_KEY=""
POSTHOG_HOST="https://app.posthog.com"

# Firebase Admin (For server-side Auth validation)
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
