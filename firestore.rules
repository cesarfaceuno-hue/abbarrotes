rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check authentication
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check tenant ownership - Zero Trust strict check
    function belongsToTenant(tenantId) {
      return isAuthenticated() && (
        request.auth.token.tenantId == tenantId ||
        (request.auth.token.tenants != null && request.auth.token.tenants[tenantId] == true)
      );
    }

    // Helper: Check if user is registered inside the Organization's users subcollection
    function isOrgMember(orgId) {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/organizations/$(orgId)/users/$(request.auth.uid)) ||
        request.auth.token.orgId == orgId
      );
    }

    // --- Global Catalog Collections ---
    match /global_products/{prodId} {
      allow read: if isAuthenticated();
      allow write: if false; // Scrapers only write via Firebase Admin (Server-side bypass)
    }

    match /global_suppliers/{suppId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // --- Legacy Flat Collections (Backward Compatibility) ---
    match /masterProducts/{productId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.token.admin == true;
    }

    match /tenants/{tenantId} {
      allow read, write: if belongsToTenant(tenantId);

      match /inventory/{inventoryId} {
        allow read: if belongsToTenant(tenantId);
        allow create, update: if belongsToTenant(tenantId) && request.resource.data.tenantId == tenantId;
        allow delete: if belongsToTenant(tenantId);
      }

      match /{subcollection}/{documentId} {
        allow read, write: if belongsToTenant(tenantId);
      }
    }

    // --- New Hierarchical Multi-Tenant Collections (Tenant Isolation) ---
    match /organizations/{orgId} {
      allow read: if isOrgMember(orgId);
      allow write: if isOrgMember(orgId) && (
        get(/databases/$(database)/documents/organizations/$(orgId)/users/$(request.auth.uid)).data.role == 'OWNER' ||
        get(/databases/$(database)/documents/organizations/$(orgId)/users/$(request.auth.uid)).data.role == 'ADMIN'
      );

      match /users/{userId} {
        allow read: if isOrgMember(orgId);
        allow write: if isOrgMember(orgId) && userId == request.auth.uid;
      }

      match /audit_logs/{logId} {
        allow read: if isOrgMember(orgId);
        allow create: if isOrgMember(orgId);
        allow update, delete: if false; // IMMUTABLE AUDIT LOG
      }

      match /stores/{storeId} {
        allow read: if isOrgMember(orgId);
        allow write: if isOrgMember(orgId) && (
          get(/databases/$(database)/documents/organizations/$(orgId)/users/$(request.auth.uid)).data.role == 'OWNER' ||
          get(/databases/$(database)/documents/organizations/$(orgId)/users/$(request.auth.uid)).data.role == 'ADMIN'
        );

        match /inventory/{productId} {
          allow read: if isOrgMember(orgId);
          allow write: if isOrgMember(orgId);
        }

        match /sales/{saleId} {
          allow read: if isOrgMember(orgId);
          allow create: if isOrgMember(orgId);
          allow update, delete: if false; // POS TRANSACTIONS IMMUTABLE
        }

        match /ledger/{movementId} {
          allow read: if isOrgMember(orgId);
          allow create: if isOrgMember(orgId);
          allow update, delete: if false; // KARDEX IMMUTABILITY GUARANTEED
        }
      }
    }

    // Legacy Audit Logs: Append-only immutability
    match /auditLogs/{auditId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.tenantId != null;
      allow update, delete: if false;
    }

    // Default fallback: Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
